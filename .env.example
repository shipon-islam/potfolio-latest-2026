# Copy this file to .env.local and fill in your real values.

# Where the contact form sends messages (it opens the visitor's email app).
NEXT_PUBLIC_CONTACT_EMAIL=you@example.com

# Shown in the footer as a tap-to-call link. Write it the way you want it read
# on screen; the tel: link strips spaces and dashes.
NEXT_PUBLIC_CONTACT_PHONE="+880 1641758653"

# Your live domain, no trailing slash. Used for canonical URLs, Open Graph tags,
# robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional. Put your resume in /public (e.g. /resume.pdf) and set this to show
# the download button. Leave it out to hide the button.
NEXT_PUBLIC_RESUME_URL=/resume.pdf

